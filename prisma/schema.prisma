generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  bookmarks Bookmark[]
}

model Bookmark {
  id        String   @id @default(uuid())
  title     String
  url       String
  tags      String[]
  folderId  String
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([createdAt])
}
